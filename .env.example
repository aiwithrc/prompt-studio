# ---------- Core ----------
# Public URL of the app. Used for auth callbacks and password-reset links.
APP_URL=http://localhost:3000
# Domain Caddy serves over HTTPS on a VPS (docker compose --profile vps). Not used locally.
APP_DOMAIN=promptstudio.rishabchaturvedi.com
# Auth.js secret: generate with `openssl rand -base64 32`
AUTH_SECRET=change-me-to-a-long-random-string
# 32-byte key, base64. Generate with `openssl rand -base64 32`. Encrypts stored API keys.
KEY_ENCRYPTION_SECRET=change-me-to-32-byte-base64-key

# ---------- Database (Postgres 16 + pgvector) ----------
DATABASE_URL=postgres://promptstudio:promptstudio@localhost:5432/promptstudio

# ---------- Email (password reset) via Gmail SMTP ----------
# Gmail needs an App Password (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Prompt Studio <you@gmail.com>"
# If SMTP is not configured, reset links are printed to the server log instead.

# ---------- Local LLM defaults (LM Studio / Ollama) ----------
# From inside Docker, the host machine is host.docker.internal.
# Outside Docker, use localhost. Tailscale IPs also work (e.g. http://100.x.y.z:1234/v1).
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------- Optional cloud keys (you can also add keys in the Settings page) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Public base URL Auth.js uses to build redirects. Set it to APP_URL.
AUTH_URL=http://localhost:3000
